{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendonna.local/evals/spec/tools/list_events.json",
  "title": "list_events",
  "description": "List calendar events in a day or week window.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "start": {
      "type": "string",
      "format": "date-time",
      "description": "Window start (RFC 3339 with offset)."
    },
    "end": {
      "type": "string",
      "format": "date-time",
      "description": "Window end (RFC 3339 with offset)."
    }
  },
  "required": ["start", "end"],
  "examples": [
    {
      "start": "2026-11-23T00:00:00+01:00",
      "end": "2026-11-30T00:00:00+01:00"
    }
  ]
}

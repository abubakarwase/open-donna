{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opendonna.local/evals/spec/trace.schema.json",
  "title": "SutTrace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "route",
    "tool_calls",
    "drafts",
    "escalation",
    "executed_side_effects",
    "steps",
    "latency_ms",
    "peak_rss_bytes"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z]+-[0-9]{4}$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence"],
      "properties": {
        "label": { "type": "string" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "args"],
        "properties": {
          "name": { "type": "string" },
          "args": { "type": "object" }
        }
      }
    },
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "payload"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["email", "event", "event_update", "event_cancel"]
          },
          "payload": { "type": "object" }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escalated", "reason", "payload_bytes"],
      "properties": {
        "escalated": { "type": "boolean" },
        "reason": {
          "type": ["string", "null"]
        },
        "payload_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "consent": {
          "type": "string",
          "enum": ["local_only", "requested", "granted", "denied"]
        }
      }
    },
    "executed_side_effects": {
      "type": "array"
    },
    "steps": {
      "type": "integer",
      "minimum": 0
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "peak_rss_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "answer": { "type": "string" },
    "error": { "type": "string" }
  }
}
